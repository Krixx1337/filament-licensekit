{
    "name": "licensekit/licensekit",
    "description": "Software licensing APIs and Filament administration for Laravel.",
    "keywords": ["laravel", "filament", "filament-plugin", "licensing", "license-keys", "hwid"],
    "homepage": "https://github.com/Krixx1337/filament-licensekit",
    "support": {
        "issues": "https://github.com/Krixx1337/filament-licensekit/issues",
        "source": "https://github.com/Krixx1337/filament-licensekit"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Krixx",
            "homepage": "https://github.com/Krixx1337",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/sanctum": "^4.1",
        "filament/filament": "^4.13.3 || ^5.8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.32",
        "larastan/larastan": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "LicenseKit\\": "src/",
            "LicenseKit\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LicenseKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LicenseKit\\LicenseKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=768M",
        "format": "pint",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
