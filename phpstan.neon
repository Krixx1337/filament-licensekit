includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
parameters:
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    parallel:
        maximumNumberOfProcesses: 1
    level: 7
    databaseMigrationsPath:
        - database/migrations/core
    paths:
        - src
        - database/factories
        - database/migrations
        - config
        - routes
